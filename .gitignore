# segredos / config local (nunca versionar)
.env
.mcp.json
.claude/

# macOS
.DS_Store

# bytecode do Python (tools/gen_icons.py, assets/icons_vec.py)
__pycache__/
*.pyc

# builds Rust (agent CLI e app Tauri)
agent/target/
app/target/

# gerados pelo build do Tauri (schemas/caches)
app/gen/

# intermediario da geracao de icones do app (icon.icns e o produto final)
app/icons/icon.iconset/

# artefatos eventuais do arduino-cli (--export-binaries)
firmware/**/build/

# logs locais
*.log

# binarios distribuiveis (grandes; gerados por build/CI)
# — dist/windows tem os builds do M4 para teste manual; descomente p/ nao versionar
dist/
